# =============================================================================
# .gitignore — Habit Tracker (Python 3.14 / SQLite / pytest / Click)
# Keeps the repository to source only, so it stays fully reproducible after
# a clone: install dependencies, run tests, run the app — no local files needed.
# =============================================================================

# -----------------------------------------------------------------------------
# Python byte-compiled files
# Regenerated from source on every import; never belong in version control.
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# -----------------------------------------------------------------------------
# Build and packaging artifacts
# Produced by pip / setuptools (e.g. an editable install creates *.egg-info).
# Regenerated by `pip install`; committing them causes stale-metadata noise.
# -----------------------------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
MANIFEST

# -----------------------------------------------------------------------------
# Test, coverage, and type-checker caches
# All regenerated by running the tools; pure local state.
# -----------------------------------------------------------------------------
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# -----------------------------------------------------------------------------
# Virtual environments
# Machine-specific; the lecturer creates their own from requirements.txt.
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# -----------------------------------------------------------------------------
# Local databases
# The SQLite database is runtime data, not source. It is recreated with
# `habit init` (loads the 5 predefined habits + 4 weeks of fixtures).
# The default location is the data/ directory.
# -----------------------------------------------------------------------------
data/
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*~

# -----------------------------------------------------------------------------
# IDE / editor settings
# Personal workspace configuration, not part of the project.
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# OS-specific files (Windows primary; macOS/Linux included for safety)
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
